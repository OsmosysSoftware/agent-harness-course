#!/usr/bin/env sh
# Conventional Commits subject, and no AI attribution. No Node needed.
msg_file="$1"
subject=$(head -n1 "$msg_file")

case "$subject" in
  Merge\ *|Revert\ *) exit 0 ;;
esac

echo "$subject" | grep -Eq '^(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert)(\([a-z0-9._/-]+\))?!?: .{1,72}$' || {
  echo "commit-msg: subject must be 'type(scope): summary' (Conventional Commits, max 72 chars after the colon)." >&2
  echo "  got: $subject" >&2
  exit 1
}

if grep -Eqi '^(co-authored-by: .*(claude|codex|gemini|copilot|anthropic|openai|noreply@)|.*generated with .*(claude|codex|gemini|antigravity))' "$msg_file"; then
  echo "commit-msg: AI attribution lines are not allowed in company repos. Remove the trailer." >&2
  exit 1
fi
exit 0
